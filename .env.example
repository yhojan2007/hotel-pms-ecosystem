# Base de Datos PostgreSQL
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=pms_password_secret
POSTGRES_DB=hotel_pms_db
DATABASE_URL=postgresql+asyncpg://pms_user:pms_password_secret@db:5432/hotel_pms_db
SYNC_DATABASE_URL=postgresql+psycopg://pms_user:pms_password_secret@db:5432/hotel_pms_db

# API Backend
PROJECT_NAME="Hotel PMS Ecosystem"
API_V1_STR=/api/v1
SECRET_KEY=change_this_secret_key_for_production_demo

# Integraciones de IA y Comunicaciones (Fases 3 y 5)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ZAVU_API_KEY=your_zavu_api_key_here
ZAVU_PHONE_NUMBER_ID=your_zavu_phone_number_id_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
